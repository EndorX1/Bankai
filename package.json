{
	"name": "Bankai",
	"version": "2.0.0",
	"description": "Sync Sharepoint files to Obsidian vault and lets you access them easily.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"watch": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"build": "node esbuild.config.mjs production",
		"copy:linux": "mkdir -p ../TestVault/.obsidian/plugins/bankai && cp main.js manifest.json styles.css ../TestVault/.obsidian/plugins/bankai/",
		"test:linux": "npm run build && npm run copy:linux",
		"clean": "rm -f main.js",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
